FROM python:3.11-slim

# Install FFmpeg and system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy and install Python dependencies (excluding pywebview)
COPY requirements-docker.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY src/ src/

# Ship the model catalog config (see config/model_catalog/catalog.meta.yaml —
# get_default_model_settings() reads it at import time in models.py; without
# this the container dies with FileNotFoundError before uvicorn ever binds).
COPY config/ config/

# Create output directories
RUN mkdir -p output/uploads output/video output/assets output/storyboard \
    output/audio output/export output/video_inputs output/outputs/videos

# Ship BGM preset audio (see output/presets/bgm/LICENSES.md — currently
# placeholders; without these files every export with BGM comes out silent).
COPY output/presets/ output/presets/

# Environment
ENV NO_PROXY="*.aliyuncs.com,localhost,127.0.0.1"
ENV no_proxy="*.aliyuncs.com,localhost,127.0.0.1"
ENV PYTHONUNBUFFERED=1

EXPOSE 17177

CMD ["python", "-m", "uvicorn", "src.apps.comic_gen.api:app", "--host", "0.0.0.0", "--port", "17177"]
