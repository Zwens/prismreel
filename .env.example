# ===============================
# Google Gemini (必填)
# 承担 LLM(剧本/分镜/提示词润色)；后续迁移中还将承担图像与配音
# 申请: https://aistudio.google.com/apikey
# ===============================
GEMINI_API_KEY=your_gemini_api_key_here
# 可选：自定义端点(走中转/代理时使用，留空用官方地址)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# 阿里云 DashScope API Key (下线中：LLM 已切至 Gemini，图像侧尚未迁移)
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 阿里云 Access Key (用于 OSS、视频超分等服务)
ALIBABA_CLOUD_ACCESS_KEY_ID=your_aliyun_access_key_id_here
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_aliyun_access_key_secret_here

# OSS 配置 (可选，用于图片/视频存储)
OSS_BUCKET_NAME=your_bucket_name
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BASE_PATH=comic_gen/

# Kling AI 配置 (可选，用于 Kling 视频生成)
KLING_ACCESS_KEY=your_kling_access_key_here
KLING_SECRET_KEY=your_kling_secret_key_here

# Vidu AI 配置 (可选，用于 Vidu 视频生成)
VIDU_API_KEY=your_vidu_api_key_here

# BytePlus / Volcano Ark 配置 (用于 Seedance 系列视频生成)
# 必需：API Key (从 BytePlus ModelArk 控制台获取)
ARK_API_KEY=your_ark_api_key_here
# 可选：区域选择 (intl=国际, cn=中国; 默认 intl)
# ARK_REGION=intl
# 可选：完整 API Base URL 覆盖 (若留空则根据 ARK_REGION 自动选择)
# ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# 注意：Ark API Key 仅是访问权限；还需在 BytePlus ModelArk 控制台激活 Seedance 模型
# 如模型未激活，API 调用将返回 404 错误

# LLM 多模型适配 (可选)
# 默认使用 Gemini (通过其 OpenAI 兼容层 /v1beta/openai/ 调用，只需上方 GEMINI_API_KEY)
# LLM_PROVIDER=gemini
#
# 如需切换到第三方 OpenAI 兼容 API (OpenAI/DeepSeek/Ollama 等):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
#
# DeepSeek 示例:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_deepseek_api_key
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
#
# 本地 Ollama 示例:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:72b

# API 服务配置
API_HOST=0.0.0.0
API_PORT=8000

# ===============================
# API 端点配置 (可选，海外部署时切换到国际端点)
# 命名约定: {PROVIDER}_BASE_URL
# ===============================
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com
# KLING_BASE_URL=https://api.klingai.com/v1
# VIDU_BASE_URL=https://api.vidu.cn/ent/v2
