# ===============================
# Google Gemini (必填)
# 承担 LLM(剧本/分镜/提示词润色)、图像生成、语音合成
# 申请: https://aistudio.google.com/apikey
# ===============================
GEMINI_API_KEY=your_gemini_api_key_here
# 可选：自定义端点(走中转/代理时使用，留空用官方地址)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# 阿里云 Access Key (用于 OSS、视频超分等服务)
ALIBABA_CLOUD_ACCESS_KEY_ID=your_aliyun_access_key_id_here
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_aliyun_access_key_secret_here

# OSS 配置 (可选，用于图片/视频存储)
OSS_BUCKET_NAME=your_bucket_name
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BASE_PATH=comic_gen/
# OSS 请求超时（秒）。oss2 把它同时当连接和响应超时用，而 OSS 要等整个文件传完才回应答，
# 所以这实际上是「一次上传的最长耗时」。上行慢的网络传视频时把它调大。
OSS_TIMEOUT_SECONDS=120

# Kling AI 配置 (可选，用于 Kling 视频生成)
KLING_ACCESS_KEY=your_kling_access_key_here
KLING_SECRET_KEY=your_kling_secret_key_here

# Vidu AI 配置 (可选，用于 Vidu 视频生成)
VIDU_API_KEY=your_vidu_api_key_here

# DeeVid AI 配置 (可选，用于 DeeVid Quality V4.0 图生视频)
DEEVID_API_KEY=your_deevid_api_key_here

# BytePlus / Volcano Ark 配置 (用于 Seedance 系列视频生成)
# 必需：API Key (从 BytePlus ModelArk 控制台获取)
ARK_API_KEY=your_ark_api_key_here
# 可选：区域选择 (intl=国际, cn=中国; 默认 intl)
# ARK_REGION=intl
# 可选：完整 API Base URL 覆盖 (若留空则根据 ARK_REGION 自动选择)
# ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# 注意：Ark API Key 仅是访问权限；还需在 BytePlus ModelArk 控制台激活 Seedance 模型
# 如模型未激活，API 调用将返回 404 错误

# LLM 多模型适配 (可选)
# 默认使用 Gemini (通过其 OpenAI 兼容层 /v1beta/openai/ 调用，只需上方 GEMINI_API_KEY)
# LLM_PROVIDER=gemini   (可选值: gemini | openai)
#
# 如需切换到第三方 OpenAI 兼容 API (OpenAI/DeepSeek/Ollama 等):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
#
# DeepSeek 示例:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_deepseek_api_key
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
#
# 本地 Ollama 示例:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:72b

# API 服务配置
API_HOST=0.0.0.0
API_PORT=8000

# ===============================
# API 端点配置 (可选，海外部署时切换到国际端点)
# 命名约定: {PROVIDER}_BASE_URL
# ===============================
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# KLING_BASE_URL=https://api.klingai.com/v1
# VIDU_BASE_URL=https://api.vidu.cn/ent/v2

# ===============================
# 安全配置（VPS/多人共享部署时建议设置）
# ===============================
# API Key 门禁：设置后，除 /health /files /static /docs /openapi.json 外的所有请求
# 都必须带 X-API-Key header，否则返回 401。留空 = 不验证（桌面单机模式行为不变）。
# 设置后必须在前端构建时传入相同值到 NEXT_PUBLIC_API_KEY（见下）。
PRISMREEL_API_KEY=

# 前端构建时内嵌到浏览器 bundle 的 API Key，须与上方 PRISMREEL_API_KEY 一致。
# 注意：NEXT_PUBLIC_* 会被打包进前端静态文件，任何能加载页面的人都能看到这个值，
# 这道防护只能挡外部随机扫描/未授权直接调用 API，无法防范已能打开页面的人。
NEXT_PUBLIC_API_KEY=

# CORS 允许来源，逗号分隔（如 https://your-domain.com）。留空 = 仅放行
# localhost/127.0.0.1（任意端口），用于本机开发时前后端不同 port 的跨域登入
# cookie 请求；正式多人部署务必设置为实际域名，否则浏览器会拒绝该域名的请求。
PRISMREEL_CORS_ORIGINS=

# 每个来源（按 X-API-Key 或来源 IP 区分）每分钟最多可调用几次 /generate_* 端点，防止额度被刷爆。
PRISMREEL_GENERATION_RATE_LIMIT=20

# ===============================
# 多租户登录系统（2026-09-08 新增）
# ===============================
# JWT 签章密钥，多用户部署必填；留空 = 完全停用登录闸门（desktop 单机模式行为）。
# 正式环境务必用高熵随机字串，例如: openssl rand -hex 32
PRISMREEL_JWT_SECRET=

# 首次启动迁移脚本用来建立预设 admin 账号，仅在 output/auth.db 尚无任何使用者时生效。
PRISMREEL_ADMIN_EMAIL=
PRISMREEL_ADMIN_PASSWORD=

# JWT 有效天数，选填，预设 7。
PRISMREEL_JWT_EXPIRE_DAYS=7
